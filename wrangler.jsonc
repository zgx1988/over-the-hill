{
  "name": "trailbound-valley",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/ws", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "VALLEY", "class_name": "Valley" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Valley"] }]
}
